# ============================================================
# SAP GUI 自动化配置模板
# 使用方式：复制本文件为 .env，然后填入真实值
#   cp .env.example .env
# 注意：.env 含明文密码，切勿提交到版本库
# ============================================================

# ---------- 基础配置 ----------
# SAP Logon 可执行文件路径
SAPLOGON_PATH=C:\Program Files (x86)\SAP\FrontEnd\SAPgui\saplogon.exe

# 未通过命令行指定 client 时使用的默认 client
SAP_DEFAULT_CLIENT=120

# 各种等待的超时时间（秒）
SAP_STARTUP_TIMEOUT=30
SAP_CONNECT_TIMEOUT=30
SAP_POPUP_TIMEOUT=8

# 后台（VBS 启动器）运行看不到控制台输出，建议保留此行以便排查。
# 相对路径（如 OpenSAPGUI.log）会写到程序所在目录；也支持 %TEMP%\xxx.log 等绝对/环境变量写法；留空则不写文件。
SAP_LOG_FILE=OpenSAPGUI.log

# ---------- 连接配置 ----------
# 每组连接三个变量：SAP_CONN_<ID>_NAME / _USER / _PASSWORD
# <ID> 只是分组标记，可随意命名（如 DEV/QAS/PRD）；真正被引用的是 NAME 的值
SAP_CONN_1D_NAME=BH-1D
SAP_CONN_1D_USER=your_user
SAP_CONN_1D_PASSWORD=your_password

SAP_CONN_2Q_NAME=BH-2Q
SAP_CONN_2Q_USER=your_user
SAP_CONN_2Q_PASSWORD=your_password

SAP_CONN_3P_NAME=BH-3P
SAP_CONN_3P_USER=your_user
SAP_CONN_3P_PASSWORD=your_password

# ---------- client -> 连接 映射规则 ----------
# 格式：前缀:连接名，多组用逗号分隔；按书写顺序优先匹配（大小写不敏感）
# 例：SAP_CLIENT_MAP=8:BH-3P,6:BH-2Q
#     表示 client 以 8 开头走 BH-3P，以 6 开头走 BH-2Q
SAP_CLIENT_MAP=8:BH-3P,6:BH-2Q

# 所有规则都不匹配时的兜底连接名
SAP_CLIENT_FALLBACK=BH-1D
